{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/sets/(.*)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/(.*)\\.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/exam/studydata/(.*)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ],
  "rewrites": [
    {"source": "/", "has": [{"type": "host", "value": "exam.terrys.kr"}], "destination": "/exam"},
    {"source": "/admin", "has": [{"type": "host", "value": "exam.terrys.kr"}], "destination": "/exam/admin"},
    {"source": "/study", "has": [{"type": "host", "value": "exam.terrys.kr"}], "destination": "/exam/study"}
  ]
}
